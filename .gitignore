# --- Rust / Cargo ---
# Hasil kompilasi (debug, release, incremental, flycheck, dll.)
/target/

# Cargo.lock tetap di-commit karena ini aplikasi (bukan library)

# Backup dari rustfmt
**/*.rs.bk

# Output cargo-mutants (jika dipakai)
mutants.out*/

# --- Meson ---
# Direktori build
/build/
/_build/
/builddir/

# File yang dihasilkan Meson dari template *.in
/src/config.rs

# --- Flatpak ---
.flatpak-builder/
/flatpak-build/
/repo/
*.flatpak

